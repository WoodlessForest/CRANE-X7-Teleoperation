--- /dev/null
+++ b/rt_manipulators_lib/include/recording_feedback.hpp
@@ -0,0 +1,44 @@
+#pragma once
+#include <cstdint>
+#include <map>
+#include <mutex>
+#include <string>
+#include <vector>
+namespace rt_manipulators_cpp {
+struct PositionFeedback {
+  bool enabled = false, updated = false, last_read_ok = false;
+  int64_t update_ns = 0, attempt_ns = 0;
+  uint64_t sequence = 0;
+  std::vector<double> positions;
+};
+// Separate from Joint's caches. No lock is held over serial IO.
+class RecordingFeedback {
+ public:
+  void configure(const std::string& group, bool enabled) {
+    std::lock_guard<std::mutex> lock(mutex_);
+    groups_[group] = PositionFeedback{};
+    groups_[group].enabled = enabled;
+  }
+  void publish(const std::string& group, bool ok,
+               const std::vector<double>& positions, int64_t time_ns) {
+    std::lock_guard<std::mutex> lock(mutex_);
+    auto& f = groups_.at(group);
+    f.attempt_ns = time_ns;
+    f.last_read_ok = ok && f.enabled;
+    if (f.last_read_ok) {
+      f.positions = positions;
+      f.update_ns = time_ns;
+      ++f.sequence;
+      f.updated = true;
+    }
+  }
+  PositionFeedback snapshot(const std::string& group) const {
+    std::lock_guard<std::mutex> lock(mutex_);
+    auto it = groups_.find(group);
+    return it == groups_.end() ? PositionFeedback{} : it->second;
+  }
+ private:
+  mutable std::mutex mutex_;
+  std::map<std::string, PositionFeedback> groups_;
+};
+}
